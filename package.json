{
  "name": "@hivecommons/rationguard",
  "version": "0.12.0",
  "description": "Detect and rebut rationalization patterns in AI agent output",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rationguard": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch",
    "test": "node --test dist/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=99 --test-coverage-branches=95 --test-coverage-functions=100 dist/*.test.js",
    "test:workflows": "node --test .github/tests/*.test.cjs",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "agent",
    "rationalization",
    "excuse",
    "defense",
    "guard",
    "llm",
    "cli",
    "ai-agents",
    "guardrails",
    "prompt-engineering",
    "claude",
    "claude-code",
    "copilot",
    "gemini",
    "goose",
    "codex",
    "tmux"
  ],
  "author": "hivecommons",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hivecommons/rationguard.git"
  },
  "bugs": {
    "url": "https://github.com/hivecommons/rationguard/issues"
  },
  "homepage": "https://github.com/hivecommons/rationguard#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/*.test.js",
    "!dist/*.test.js.map",
    "!dist/*.test.d.ts",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@hivecommons/pluk": "^0.10.0"
  }
}
